{
  "name": "huhu",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-or-later",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "oxlint -c oxlint.json . && node scripts/check-lint-rules.mjs",
    "typecheck": "pnpm --filter \"./vendor/*\" run build:types && pnpm -r --parallel run typecheck",
    "test": "vitest run",
    "build": "pnpm -r run build",
    "gen": "node scripts/gen-guide.mjs",
    "e2e": "playwright test",
    "dev": "pnpm --filter @huhu/desktop dev"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.0.0",
    "oxlint": "1.93.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
