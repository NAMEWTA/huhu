{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": ["vendor/**", "packages/editor/src/vendor/**", ".agents/**", "scripts/lint-samples/**", "examples/**"],
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs", "tests/e2e/*.spec.ts", "tests/e2e/workflows/*.spec.ts", "tests/perf/*.bench.ts", "tests/perf/vitest.config.ts"]
    },
    "packages/vault": {
      "entry": ["test/fixtures/*.mjs"],
      "ignoreDependencies": ["tsx"]
    },
    "apps/desktop": {
      "ignoreDependencies": ["@parcel/watcher", "ssh2"],
      "entry": ["scripts/before-pack.cjs", "src/index.ts"]
    },
    "apps/cli": {
      "entry": ["src/bin.ts"]
    },
    "plugins/tasks": {
      "ignoreDependencies": ["tsx"]
    }
  }
}
