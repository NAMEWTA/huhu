{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": ["vendor/**", "packages/editor/src/vendor/**", ".agents/**", "scripts/lint-samples/**", "examples/**", "packages/editor/build/**", "packages/editor/harness/**", "packages/editor/src/host/**", "playwright.vendor.config.ts"],
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.mjs",
        "tests/e2e/*.spec.ts",
        "tests/e2e/workflows/*.spec.ts",
        "tests/parity-ok/compare.spec.ts",
        "tests/parity-ok/playwright.config.ts",
        "tests/perf/*.bench.ts",
        "tests/perf/vitest.config.ts",
        "tests/visual/*.spec.ts",
        "playwright.visual.config.ts"
      ]
    },
    "packages/vault": {
      "entry": ["test/fixtures/*.mjs"],
      "ignoreDependencies": ["tsx"]
    },
    "apps/desktop": {
      "ignoreDependencies": ["@napi-rs/keyring", "@parcel/watcher", "imapflow", "nodemailer", "ssh2"],
      "entry": ["scripts/before-pack.cjs", "src/index.ts"]
    },
    "apps/cli": {
      "entry": ["src/bin.ts"],
      "ignoreDependencies": ["tsx"]
    },
    "plugins/agent-cli": {
      "entry": ["src/engine/codex-dispatch-helper.cjs", "src/engine/protected-launch-helper.cjs"]
    },
    "plugins/tasks": {
      "ignoreDependencies": ["tsx"]
    },
    "plugins/versioning": {
      "ignoreBinaries": ["taskkill.exe"]
    },
    "packages/editor": {
      "ignoreDependencies": [
        "@fontsource-variable/inter",
        "@fontsource-variable/jetbrains-mono",
        "@types/diff-match-patch",
        "diff-match-patch",
        "mdast-util-to-hast",
        "micromark-util-sanitize-uri",
        "node-diff3",
        "rehype-stringify",
        "remark-rehype",
        "vite-tsconfig-paths",
        "y-indexeddb"
      ],
      "paths": {
        "@/*": ["src/vendor/open-knowledge/app/src/*"]
      }
    },
    "packages/ui": {
      "ignoreDependencies": ["@fontsource-variable/geist", "@fontsource-variable/geist-mono", "@fontsource-variable/inter", "@fontsource-variable/jetbrains-mono", "@fontsource-variable/newsreader"]
    }
  }
}
