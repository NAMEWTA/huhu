{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": ["vendor/**", "packages/editor/src/vendor/**", ".agents/**", "scripts/lint-samples/**", "examples/**", "packages/editor/build/**", "packages/editor/harness/**", "packages/editor/src/host/**", "playwright.vendor.config.ts"],
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs", "tests/e2e/*.spec.ts", "tests/e2e/workflows/*.spec.ts", "tests/perf/*.bench.ts", "tests/perf/vitest.config.ts", "tests/visual/*.spec.ts", "playwright.visual.config.ts"]
    },
    "packages/vault": {
      "entry": ["test/fixtures/*.mjs"],
      "ignoreDependencies": ["tsx"]
    },
    "apps/desktop": {
      "ignoreDependencies": ["@parcel/watcher", "ssh2"],
      "entry": ["scripts/before-pack.cjs", "src/index.ts"]
    },
    "apps/cli": {
      "entry": ["src/bin.ts"]
    },
    "plugins/tasks": {
      "ignoreDependencies": ["tsx"]
    },
    "packages/editor": {
      "ignoreDependencies": [
        "@codemirror/lang-css",
        "@codemirror/lang-html",
        "@codemirror/lang-javascript",
        "@codemirror/lang-markdown",
        "@codemirror/lang-python",
        "@codemirror/lang-rust",
        "@codemirror/lang-yaml",
        "@codemirror/legacy-modes",
        "@dnd-kit/core",
        "@dnd-kit/sortable",
        "@dnd-kit/utilities",
        "@excalidraw/excalidraw",
        "@floating-ui/dom",
        "@fontsource-variable/inter",
        "@fontsource-variable/jetbrains-mono",
        "@lingui/core",
        "@panzoom/panzoom",
        "@pierre/trees",
        "@tiptap/extension-collaboration",
        "@tiptap/extension-drag-handle",
        "@tiptap/extension-file-handler",
        "@tiptap/extension-placeholder",
        "@tiptap/react",
        "@tiptap/suggestion",
        "@types/diff-match-patch",
        "@u-wave/react-vimeo",
        "@visimer/core",
        "@visimer/dom",
        "class-variance-authority",
        "clsx",
        "cmdk",
        "codemirror-lang-mermaid",
        "date-fns",
        "diff-match-patch",
        "frimousse",
        "highlight.js",
        "ipaddr.js",
        "lowlight",
        "lucide-react",
        "mdast-util-to-hast",
        "micromark-util-sanitize-uri",
        "node-diff3",
        "pdfjs-dist",
        "radix-ui",
        "react-day-picker",
        "react-error-boundary",
        "react-force-graph-2d",
        "react-lite-youtube-embed",
        "react-medium-image-zoom",
        "rehype-parse",
        "rehype-remark",
        "rehype-stringify",
        "remark-rehype",
        "scheduler-polyfill",
        "sonner",
        "tailwind-merge",
        "vite-tsconfig-paths",
        "web-vitals",
        "y-codemirror.next",
        "y-indexeddb"
      ]
    },
    "packages/ui": {
      "ignoreDependencies": ["@fontsource-variable/geist", "@fontsource-variable/geist-mono", "@fontsource-variable/inter", "@fontsource-variable/jetbrains-mono", "@fontsource-variable/newsreader"]
    }
  }
}
