{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": ["vendor/**", "packages/editor/src/vendor/**", ".agents/**", "scripts/lint-samples/**", "examples/**", "packages/editor/build/**", "packages/editor/harness/**", "playwright.vendor.config.ts"],
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.mjs",
        "tests/e2e/*.spec.ts",
        "tests/e2e/workflows/*.spec.ts",
        "tests/parity-ok/compare.spec.ts",
        "tests/parity-ok/playwright.config.ts",
        "tests/perf/*.bench.ts",
        "tests/perf/vitest.config.ts",
        "tests/visual/*.spec.ts",
        "playwright.visual.config.ts"
      ]
    },
    "packages/vault": {
      "entry": ["test/fixtures/*.mjs"],
      "ignoreDependencies": ["tsx"]
    },
    "apps/desktop": {
      "ignoreDependencies": ["@parcel/watcher", "ssh2"],
      "entry": ["scripts/before-pack.cjs", "src/index.ts"]
    },
    "apps/cli": {
      "entry": ["src/bin.ts"]
    },
    "plugins/tasks": {
      "ignoreDependencies": ["tsx"]
    },
    "packages/editor": {
      "entry": ["src/host/core-barrel.ts", "src/host/hocuspocus-server.ts", "src/host/next-themes-shim.tsx"],
      "ignoreDependencies": ["@fontsource-variable/inter", "@fontsource-variable/jetbrains-mono", "vite-tsconfig-paths", "y-indexeddb"],
      "paths": {
        "@/*": ["src/vendor/open-knowledge/app/src/*"],
        "@inkeep/open-knowledge-core/*": ["src/vendor/open-knowledge/core/src/*"]
      }
    },
    "packages/ui": {
      "ignoreDependencies": ["@fontsource-variable/geist", "@fontsource-variable/geist-mono", "@fontsource-variable/inter", "@fontsource-variable/jetbrains-mono", "@fontsource-variable/newsreader"]
    }
  }
}
