--- a/dist/index.cjs
+++ b/dist/index.cjs
@@ -3563,8 +3563,23 @@ handlers.focus = function (view) {
     view.dom.classList.add("ProseMirror-focused");
     view.domObserver.start();
     view.focused = true;
+    var startSel = view.domSelectionRange(),
+      anchorNode = startSel.anchorNode,
+      anchorOffset = startSel.anchorOffset,
+      focusNode = startSel.focusNode,
+      focusOffset = startSel.focusOffset;
     setTimeout(function () {
-      if (view.docView && view.hasFocus() && !view.domObserver.currentSelection.eq(view.domSelectionRange())) selectionToDOM(view);
+      if (!view.docView || !view.hasFocus()) return;
+      var sel = view.domSelectionRange();
+      if (view.domObserver.currentSelection.eq(sel)) return;
+      if (view.editable && !view.composing && sel.anchorNode && sel.focusNode && view.dom.contains(sel.anchorNode) && view.dom.contains(sel.focusNode) && !selectionCollapsed(sel)) {
+        view.domObserver.flush();
+        if (!view.docView || !view.hasFocus()) return;
+        sel = view.domSelectionRange();
+        // Preserve a range formed after focus even if the observer hasn't caught up yet.
+        if (sel.anchorNode && sel.focusNode && !selectionCollapsed(sel) && (sel.anchorNode != anchorNode || sel.anchorOffset != anchorOffset || sel.focusNode != focusNode || sel.focusOffset != focusOffset)) return;
+      }
+      if (!view.domObserver.currentSelection.eq(sel)) selectionToDOM(view);
     }, 20);
   }
 };
