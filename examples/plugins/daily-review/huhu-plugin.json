{
  "id": "daily-review",
  "title": "每日回顾",
  "description": "汇总未完成任务和笔记数量，生成一篇「每日回顾」笔记。",
  "version": "1.0.0",
  "origin": "external",
  "main": "main.mjs",
  "publisher": "HUHU 示例",
  "tags": ["回顾", "任务", "笔记"],
  "dependsOn": [],
  "permissions": ["tasks.read", "notes.read", "notes.write"],
  "contributes": {
    "commandDescriptors": [
      {
        "owner": "daily-review",
        "commandId": "generate",
        "title": "每日回顾：生成今天的回顾笔记",
        "description": "汇总当前笔记和未完成任务，写入一份每日回顾",
        "scope": "write",
        "risk": "normal",
        "retry": "durable-steps",
        "input": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": false
        },
        "output": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "tasks": {
              "type": "integer"
            },
            "notes": {
              "type": "integer"
            }
          },
          "required": ["path", "tasks", "notes"],
          "additionalProperties": false
        },
        "dependencies": ["tasks.list", "notes.list", "notes.create", "notes.read", "notes.save"]
      }
    ]
  }
}
