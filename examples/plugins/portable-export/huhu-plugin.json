{
  "id": "portable-export",
  "title": "便携导出",
  "description": "把全部笔记合并成一个 Markdown 文件，由桌面端弹出保存对话框。",
  "version": "1.0.0",
  "origin": "external",
  "main": "main.mjs",
  "publisher": "HUHU 示例",
  "tags": ["导出", "Markdown"],
  "dependsOn": [],
  "permissions": ["notes.read"],
  "contributes": {
    "commandDescriptors": [
      {
        "owner": "portable-export",
        "commandId": "export",
        "title": "便携导出：合并全部笔记为一个 Markdown",
        "description": "返回聚合后的 Markdown 正文和笔记数量",
        "scope": "read",
        "risk": "high",
        "retry": "read-only",
        "input": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": false
        },
        "output": {
          "type": "object",
          "properties": {
            "saveFile": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "content": {
                  "type": "string"
                }
              },
              "required": ["name", "content"],
              "additionalProperties": false
            },
            "count": {
              "type": "integer"
            }
          },
          "required": ["saveFile", "count"],
          "additionalProperties": false
        },
        "dependencies": ["notes.list", "notes.read"]
      }
    ]
  }
}
