{
  "id": "quick-clip",
  "title": "快速剪藏",
  "description": "一键把想法或剪贴内容收集到收件箱，来源标记为 plugin:quick-clip。",
  "version": "1.0.0",
  "origin": "external",
  "main": "main.mjs",
  "publisher": "HUHU 示例",
  "tags": ["收集", "收件箱"],
  "dependsOn": [],
  "permissions": ["inbox.write"],
  "contributes": {
    "commandDescriptors": [
      {
        "owner": "quick-clip",
        "commandId": "clip",
        "title": "快速剪藏：收集一条想法",
        "description": "将指定内容保存到收件箱",
        "scope": "write",
        "risk": "normal",
        "retry": "durable-steps",
        "input": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "output": {
          "type": "object",
          "properties": {
            "captured": {
              "type": "string"
            },
            "title": {
              "type": "string"
            }
          },
          "required": ["captured", "title"],
          "additionalProperties": false
        },
        "dependencies": ["inbox.capture"]
      }
    ]
  }
}
