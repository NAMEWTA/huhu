    "modules": ["agent-cli"],
    "settingsPages": ["agent-cli"],
    "homeWidgets": ["entry"],
    "commands": [],
    "capabilities": [
      "agent.catalog.detect",
      "agent.catalog.refresh",
      "agent.core.restart",
      "agent.core.status",
      "agent.history.list",
      "agent.history.locate",
      "agent.history.pin",
      "agent.history.read",
      "agent.history.resume",
      "agent.history.workspaceLaunch",
      "agent.launch.environments.list",
      "agent.launch.environments.preview",
      "agent.launch.environments.save",
      "agent.launch.environments.remove",
      "agent.launch.resolve",
      "agent.review.comment.add",
      "agent.review.comment.delete",
      "agent.review.comments",
      "agent.review.diff",
      "agent.review.send",
      "agent.runs.dispatch",
      "agent.runs.inspect",
      "agent.runs.answer",
      "agent.runs.answer.inspect",
      "agent.runs.stop",
      "agent.runs.stop.inspect",
      "agent.sessions.interrupt",
      "agent.sessions.kill",
      "agent.sessions.launch",
      "agent.sessions.list",
      "agent.sessions.recover",
      "agent.sessions.output",
