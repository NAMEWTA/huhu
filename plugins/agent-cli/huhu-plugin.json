      "agent.sessions.rename",
      "agent.settings.get",
      "agent.settings.update",
      "agent.spaces.delete",
      "agent.spaces.list",
      "agent.spaces.save",
      "agent.targets.list",
      "agent.workspace.close",
      "agent.workspace.get",
      "agent.workspace.launch",
      "agent.workspace.launchProtected",
      "agent.workspace.files.list",
      "agent.workspace.files.open",
      "agent.workspace.worktrees.list",
      "agent.workspace.worktrees.open",
      "agent.workspace.worktrees.create",
      "agent.workspace.save"
