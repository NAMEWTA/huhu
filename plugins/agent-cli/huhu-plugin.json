{
  "id": "agent-cli",
  "title": "Agent CLI",
  "description": "在 Space 目录中运行 AI CLI 与终端会话",
  "version": "0.0.2-rc.1",
  "origin": "builtin",
  "dependsOn": [],
  "optionalDeps": ["safe", "tasks"],
  "permissions": ["tasks.write", "tasks.comment.system", "tasks.receipt-consume"],
  "activation": "vault-open",
