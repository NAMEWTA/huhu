{
  "id": "inbox",
  "title": "收件箱",
  "description": "快速捕获并转为任务、笔记或档案",
  "version": "0.0.1",
  "origin": "builtin",
  "dependsOn": [],
  "optionalDeps": ["tasks", "notes", "archives"],
  "permissions": ["tasks.write", "notes.write", "archives.write", "archives.read"],
  "activation": "vault-open",
  "contributes": {
    "modules": ["inbox"],
    "settingsPages": [],
    "homeWidgets": ["inbox"],
    "commands": ["inbox.capture"],
    "capabilities": ["inbox.list", "inbox.capture", "inbox.update", "inbox.convert", "inbox.dismiss", "inbox.restore", "inbox.undo", "inbox.delete"],
    "fileKinds": ["capture"]
  }
}
